# Copy to .env and fill in real values. .env itself is never committed.

# SQLite database file, relative to prisma/ (docs/specs/02-design.md §5)
DATABASE_URL="file:./dev.db"

# Random 32-byte hex string used to sign session cookies.
# Generate a new one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-random-32-byte-hex-string"
